on boot
    chown system system /dev/awinic_haptic
    chmod 0600 /dev/awinic_haptic
    chown system system /proc/vibrator/touch_style
    chmod 0660 /proc/vibrator/touch_style
    write /proc/vibrator/touch_style 1

service vendor.vibrator /vendor/bin/hw/android.hardware.vibrator.service.oplus-livetap
    class late_start
    user system
    group system input
